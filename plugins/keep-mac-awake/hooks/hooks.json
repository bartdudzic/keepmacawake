{
  "description": "Tells the agent the state of Keep Mac Awake when a session starts. Read only: it never starts, stops or changes anything.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|new|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
